{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATSPM documentation container map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productName",
    "sourcePaths",
    "logMessages",
    "examples",
    "containers"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 2
    },
    "productName": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sourcePaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "logMessages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "description", "allowedDuplicateEventIds"],
      "properties": {
        "sourcePath": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "description": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "allowedDuplicateEventIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer" }
        }
      }
    },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["propertyValues", "typeValues"],
      "properties": {
        "propertyValues": { "type": "object" },
        "typeValues": { "type": "object" }
      }
    },
    "containers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "slug",
          "sections"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "slug": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
          },
          "sections": {
            "type": "array",
            "description": "Ordered configuration section names. Use SectionName:NestedPath for named or nested configuration bindings.",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    }
  }
}
